    "interactions": [
      {
        "name": "Navegación activa",
        "trigger": "Elegir sección",
        "sequence": "Indicador anterior → nuevo botón marcado; el título recibe foco.",
        "duration": "140",
        "easing": "out",
        "interrupt": "Sustituir al elegir otra ruta.",
        "reduced": "Selección inmediata.",
        "purpose": "Orientar tras la navegación."
      },
      {
        "name": "Abrir / cerrar menú",
        "trigger": "Menu, Close o Escape",
        "sequence": "Cerrado → panel a 12 px del destino → abierto; cierre inverso.",
        "duration": "200 / 160",
        "easing": "out / in",
        "interrupt": "Invertir desde la posición actual.",
        "reduced": "Mostrar u ocultar de inmediato.",
        "purpose": "Dar acceso a las siete rutas."
      },
      {
        "name": "Revelar UW04",
        "trigger": "Activar la etiqueta del canto",
        "sequence": "Láminas juntas → desplazar óptica 6 px y adelantar muesca → detalle disponible.",
        "duration": "180",
        "easing": "out",
        "interrupt": "Revertir en segundo toque.",
        "reduced": "Ficha e ID visibles al instante.",
        "purpose": "Relacionar selección con original."
      },
      {
        "name": "Overview → Assistant",
        "trigger": "Enviar campo o abrir vacío",
        "sequence": "Acción aceptada → cambio de título → nueva vista. El estado de envío se consume una vez.",
        "duration": "0",
        "easing": "instant",
        "interrupt": "Bloquear duplicados; navegar no reenvía.",
        "reduced": "Igual.",
        "purpose": "Transferir el borrador o abrir la bienvenida."
      },
      {
        "name": "Enviar / procesar",
        "trigger": "Solicitud aceptada",
        "sequence": "Enviar queda ocupado; la muesca se desplaza 4 px una vez; espera real en reposo.",
        "duration": "140",
        "easing": "out",
        "interrupt": "Respuesta o error prevalece de inmediato.",
        "reduced": "Solo aviso textual.",
        "purpose": "Confirmar recepción."
      },
      {
        "name": "Respuesta completa",
        "trigger": "Regresa el motor",
        "sequence": "Aviso de espera → contenido completo disponible; solo el borde se asienta.",
        "duration": "120",
        "easing": "out",
        "interrupt": "Interrumpir al navegar; texto inmediato.",
        "reduced": "Cambio directo.",
        "purpose": "Indicar fin sin retrasar la lectura."
      },
      {
        "name": "Inspeccionar / volver",
        "trigger": "Activar fuente o cerrar",
        "sequence": "ID activo → ficha se desplaza hasta 8 px → título enfocado; retorno al disparador.",
        "duration": "200 / 160",
        "easing": "out / in",
        "interrupt": "Invertir; si se elige otra fuente, mostrar la última.",
        "reduced": "Reemplazo sin movimiento.",
        "purpose": "Conservar procedencia y punto de retorno."
      },
      {
        "name": "Historial / último turno",
        "trigger": "Elegir turno o Latest answer",
        "sequence": "Anclar turno por ID; marcar encabezado temporalmente, sin desplazamiento animado.",
        "duration": "0",
        "easing": "instant",
        "interrupt": "El gesto manual de lectura prevalece.",
        "reduced": "Igual.",
        "purpose": "Evitar saltos durante lectura anterior."
      },
      {
        "name": "Desplegable / limpieza",
        "trigger": "Activar detalles o Clear conversation",
        "sequence": "Control → panel o confirmación visible; confirmar reinicia, cancelar devuelve foco.",
        "duration": "120",
        "easing": "out",
        "interrupt": "Cierre inmediato con Escape cuando es diálogo.",
        "reduced": "Cambio directo.",
        "purpose": "Dar contexto y proteger el historial."
      }
    ]
